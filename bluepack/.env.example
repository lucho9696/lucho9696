# Copiar como .env (docker compose lo lee automáticamente).
# Número de WhatsApp de Blue Pack en formato internacional, solo dígitos, sin "+", espacios ni guiones:
# Argentina, celular: 54 + 9 + código de área sin 0 + número sin 15.
# WhatsApp de ventas de Blue Pack (confirmado por el cliente, +54 9 3534 12-2227): 5493534122227
# Los pedidos de la demo tienen precios ficticios: con DEMO_MODE=true el mensaje lo aclara.
WHATSAPP_NUMBER=WHATSAPP_NUMBER_HERE
DEMO_MODE=true
