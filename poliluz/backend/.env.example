# Copiar como backend/.env para correr el backend sin Docker (php -S).
# Número de WhatsApp de Poliluz en formato internacional, solo dígitos, sin "+" ni espacios.
# Ejemplo Argentina: 549 + código de área sin 0 + número sin 15  →  5493531234567
WHATSAPP_NUMBER=WHATSAPP_NUMBER_HERE
DEMO_MODE=true
# CORS_ALLOWED_ORIGINS=http://localhost:5173
